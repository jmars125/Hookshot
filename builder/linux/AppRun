#!/bin/sh
# The Hookshot AppImage: the builder window (builder/linux/hookshot_builder.py) with everything it builds the game with -
# Python and the tools, clang and lld, a glibc 2.35 sysroot, FFmpeg, SDL2 and the Vulkan back end, built already.
#   Hookshot.AppImage                  the window (and Play, once a game is built)
#   Hookshot.AppImage --play           the game built last time
#   Hookshot.AppImage --cli <args>     nx2/make_game.py itself, e.g. --cli --nup game.nup --out ~/Games/Hookshot
HERE="$(dirname "$(readlink -f "$0")")"
LIB="$HERE/usr/lib/hookshot"
export HOOKSHOT_TOOLS="$HERE/usr/share/hookshot"
export EMSDK="$LIB/emsdk"
export HOOKSHOT_SYSROOT="$LIB/sysroot"
export HOOKSHOT_FFMPEG="$LIB/ffmpeg"
export HOOKSHOT_VK_PREBUILT="$LIB/hookshot_vk.so"
export HOOKSHOT_SDL2="$LIB/libSDL2-2.0.so.0"
PY="$HERE/usr/python/bin/python3"
if [ "$1" = "--cli" ]; then
    shift
    exec "$PY" -I "$HOOKSHOT_TOOLS/nx2/make_game.py" "$@"
fi
exec "$PY" -I "$HOOKSHOT_TOOLS/builder/linux/hookshot_builder.py" "$@"
